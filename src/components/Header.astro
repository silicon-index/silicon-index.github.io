---
// SPDX-License-Identifier: AGPL-3.0-or-later
import EcosystemNav from "./EcosystemNav.astro";

interface Props {
  activeNav?: "screener" | "contribute" | "admin" | "login" | "none";
}

const { activeNav = "none" } = Astro.props;
---

<header class="border-b border-zinc-800 bg-zinc-950/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-16 py-2 flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center space-x-3">
      <a href="/" class="text-emerald-400 font-mono font-bold text-lg tracking-wider">
        SILICON_INDEX<span class="text-zinc-500 text-xs ml-1">[dev]</span>
      </a>
    </div>

    <nav class="flex items-center gap-4 text-sm flex-wrap" aria-label="Primary">
      <a href="/" class:list={["term-link", activeNav === "screener" && "term-link--active"]}>Screener</a>
      <a href="/contribute" class:list={["term-link", activeNav === "contribute" && "term-link--active"]}>Contribute</a>
      <a href="/#support-panel" class="term-link term-link--support">♥ Support</a>
      <EcosystemNav variant="header" />
    </nav>

    <div class="flex items-center gap-2">
      <span id="nav-auth-slot" class="flex items-center gap-2"></span>
    </div>
  </div>
</header>

<script>
  import { getSession, logout, ensureDemoAdmin } from "@/lib/auth";

  await ensureDemoAdmin();

  function escapeHtml(str: string): string {
    return String(str).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
  }

  const slot = document.getElementById("nav-auth-slot");
  if (slot) {
    const session = getSession();
    if (session) {
      const adminLink = session.role === "admin" ? '<a class="term-link" href="/admin">Admin</a>' : "";
      slot.innerHTML =
        adminLink +
        `<span class="term-user">${escapeHtml(session.username)}<span class="term-role">${escapeHtml(session.role)}</span></span>` +
        '<button type="button" class="term-link" id="nav-sign-out">Sign out</button>';
      document.getElementById("nav-sign-out")?.addEventListener("click", () => {
        logout();
        window.location.href = "/";
      });
    } else {
      slot.innerHTML = '<a class="term-link" href="/login">Sign in / Register</a>';
    }
  }
</script>
