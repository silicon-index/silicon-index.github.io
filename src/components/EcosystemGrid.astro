---
import EcosystemNav from "./EcosystemNav.astro";
---
<section class="ecosystem-panel px-4" aria-labelledby="ecosystem-heading">
  <div class="table-panel-header">
    <h2 id="ecosystem-heading">Ecosystem</h2>
    <span class="meta-chip">11 repositories</span>
  </div>
  <p class="ecosystem-intro">
    This portal is one of 11 modular repositories under the
    <a href="https://github.com/silicon-index" target="_blank" rel="noopener noreferrer">silicon-index</a>
    organization, split for strict separation of concerns, data hygiene, and security. Every sibling repo below
    currently has GitHub Pages disabled and contains only a stub README/LICENSE (verified via the GitHub API), so
    each card links to its <code>dev</code> branch rather than a dead Pages URL. Market Database, Contributors,
    and Donations API links are admin-editable in the <a href="/admin">Admin Panel</a>.
  </p>

  <EcosystemNav variant="quick" />

  <div class="ecosystem-grid">
    <a class="ecosystem-card ecosystem-card--current" href="https://silicon-index.github.io" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Main Portal <span class="ecosystem-card-badge">you are here</span></span>
      <span class="ecosystem-card-desc">Primary market screener, component search, and live index tables.</span>
      <span class="ecosystem-card-repo">silicon-index.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-backend-api" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Backend API</span>
      <span class="ecosystem-card-desc">REST/serverless microservices, telemetry endpoints, and data delivery.</span>
      <span class="ecosystem-card-repo">silicon-index-backend-api</span>
    </a>
    <a class="ecosystem-card" id="ecosystem-card-market-db" href="https://github.com/silicon-index/silicon-index-market-database.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Market Database <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">MongoDB schemas, validation definitions, and point-in-time recovery tooling.</span>
      <span class="ecosystem-card-repo">silicon-index-market-database.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-market-scrapers.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Market Scrapers <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Multi-source price aggregation bots with integrated whitelist sanitization.</span>
      <span class="ecosystem-card-repo">silicon-index-market-scrapers.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-ai.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">AI Models <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Mathematical models for price anomaly detection and fair-value scoring.</span>
      <span class="ecosystem-card-repo">silicon-index-ai.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-security.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Security Hub <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Security governance, incident advisories, and disclosure policies.</span>
      <span class="ecosystem-card-repo">silicon-index-security.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-admin-dashboard.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Admin Dashboard <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Internal interface for price validation and moderation controls.</span>
      <span class="ecosystem-card-repo">silicon-index-admin-dashboard.github.io</span>
    </a>
    <a class="ecosystem-card" id="ecosystem-card-contributors" href="https://github.com/silicon-index/silicon-index-contributors.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Contributors <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Guidelines, community badges, and maintainer onboarding.</span>
      <span class="ecosystem-card-repo">silicon-index-contributors.github.io</span>
    </a>
    <a class="ecosystem-card" id="ecosystem-card-donations" href="https://github.com/silicon-index/silicon-index-donations-api.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Donations API <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Financial ledger and donation processing integration.</span>
      <span class="ecosystem-card-repo">silicon-index-donations-api.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-museum.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Tech Museum <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Retrospective archive of legacy architectures and historic MSRP benchmarks.</span>
      <span class="ecosystem-card-repo">silicon-index-museum.github.io</span>
    </a>
    <a class="ecosystem-card" href="https://github.com/silicon-index/silicon-index-blog.github.io/tree/dev" target="_blank" rel="noopener noreferrer">
      <span class="ecosystem-card-name">Community Blog <span class="ecosystem-card-badge ecosystem-card-badge--dev">dev branch</span></span>
      <span class="ecosystem-card-desc">Market trend reports, teardowns, and algorithm release notes.</span>
      <span class="ecosystem-card-repo">silicon-index-blog.github.io</span>
    </a>
  </div>
</section>

<script>
  import { get as getSettings } from "@/lib/settings";

  const settings = getSettings();
  const marketDbCard = document.getElementById("ecosystem-card-market-db") as HTMLAnchorElement | null;
  const contributorsCard = document.getElementById("ecosystem-card-contributors") as HTMLAnchorElement | null;
  const donationsCard = document.getElementById("ecosystem-card-donations") as HTMLAnchorElement | null;

  if (marketDbCard) marketDbCard.href = settings.marketDbUrl;
  if (contributorsCard) contributorsCard.href = settings.contributorsUrl;
  if (donationsCard) donationsCard.href = settings.donationsApiUrl;
</script>
