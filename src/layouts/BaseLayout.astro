---
// SPDX-License-Identifier: AGPL-3.0-or-later
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  activeNav?: "screener" | "contribute" | "admin" | "login" | "none";
}

const {
  title,
  description = "Open-source, community-verified PC hardware market index and fair-value screener.",
  activeNav = "none"
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Silicon Index</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f19" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Silicon Index`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://silicon-index.github.io" />
    <meta property="og:site_name" content="Silicon Index" />
  </head>
  <body class="bg-bg text-text font-sans text-sm leading-relaxed antialiased min-h-screen flex flex-col">
    <Header activeNav={activeNav} />

    <div class="flex-1">
      <slot />
    </div>

    <Footer />
  </body>
</html>
