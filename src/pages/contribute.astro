---
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMPONENT_CATEGORIES } from "../modules/database/contracts";
import { CATEGORY_LABELS } from "../lib/specDisplay";
---
<BaseLayout title="Contribute" activeNav="contribute">
  <div class="layout layout--form px-4">
    <main class="content content--narrow">
      <section class="form-panel" aria-labelledby="contribute-heading">
        <h1 id="contribute-heading">Submit a Market Price</h1>
        <p class="form-intro">
          Anonymous submissions are welcome. Every entry is staged as
          <strong>Pending Validation</strong> and must be approved in the
          <a href="/admin">Admin Panel</a> before it counts toward the index — nothing submitted here reaches the
          catalogue directly.
        </p>
        <p class="form-intro">
          Spec fields change with the category, because the catalogue contract does: a GPU is a card on a bus and
          has no socket; a memory kit has neither socket nor architecture. Per
          <a href="/DEV-GUIDE.md">DEV-GUIDE.md</a>'s whitelist rule, spec inputs are dropdowns and numbers — no
          free-text descriptions, no seller details.
        </p>

        <p id="contribute-signed-in" class="form-note" hidden></p>

        <form id="contribute-form" novalidate>
          <div class="form-row">
            <label for="f-name">Component name</label>
            <input type="text" id="f-name" name="componentName" required maxlength="80" placeholder="e.g. Radeon RX 9070 XT" />
          </div>

          <div class="form-row form-row--split">
            <div>
              <label for="f-manufacturer">Manufacturer</label>
              <input type="text" id="f-manufacturer" name="manufacturer" required maxlength="40" placeholder="AMD" />
            </div>
            <div>
              <label for="f-year">Release year</label>
              <input type="number" id="f-year" name="releaseYear" required min="1990" max="2030" step="1" placeholder="2025" />
            </div>
          </div>

          <div class="form-row">
            <label for="f-category">Category</label>
            <select id="f-category" name="category" required>
              <option value="">Select…</option>
              {COMPONENT_CATEGORIES.map((c) => <option value={c}>{CATEGORY_LABELS[c]}</option>)}
            </select>
          </div>

          <fieldset id="spec-fieldset" class="spec-fieldset" hidden>
            <legend id="spec-legend">Specifications</legend>
            <p class="field-hint" id="spec-hint"></p>
            <div id="spec-fields"></div>
          </fieldset>

          <div class="form-row form-row--split">
            <div>
              <label for="f-price">Observed price (numeric only)</label>
              <input type="number" id="f-price" name="reportedPrice" required min="0" step="0.01" placeholder="699.00" />
            </div>
            <div>
              <label for="f-currency">Currency</label>
              <select id="f-currency" name="currency" required>
                <option value="USD">USD</option><option value="EUR">EUR</option><option value="RON">RON</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <label for="f-proof">Proof of value URL (required)</label>
            <input type="url" id="f-proof" name="proofUrl" required placeholder="https://example.com/receipt-or-listing" />
            <p class="field-hint">A link to the completed transaction or listing. No seller PII — the URL is reviewed and stripped of tracking parameters by moderators.</p>
          </div>

          <p id="form-error" class="form-error" hidden></p>
          <p id="form-success" class="form-success" hidden></p>

          <button type="submit" class="btn-primary">Submit for review</button>
        </form>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { getSession } from "@/lib/auth";
  import { stageSubmission } from "@/services/dataService";
  import { getOrCreateAnonymousId, getOrCreateContributorHash } from "@modules/contributors/identity";
  import { normalizeSku } from "@modules/database/adapters";
  import { validateSpecs } from "@modules/database/ingest";
  import { SPEC_FORM_FIELDS } from "@/lib/specForm";
  import type { ComponentCategory, SpecValue } from "@modules/database/contracts";
  import type { ContributorTier } from "@modules/contributors/contracts";

  const session = getSession();
  const noteEl = document.getElementById("contribute-signed-in") as HTMLParagraphElement;
  noteEl.hidden = false;
  noteEl.textContent = session
    ? `Submitting as ${session.username} (Trusted Contributor once approved). You can also submit anonymously by signing out.`
    : `Submitting anonymously as ${getOrCreateAnonymousId()} — a random ID stored only in this browser, never a real identity. ` +
      `It is what lets your approved submissions build a reputation without an account; clearing site data resets both.`;

  const form = document.getElementById("contribute-form") as HTMLFormElement;
  const categorySelect = document.getElementById("f-category") as HTMLSelectElement;
  const fieldset = document.getElementById("spec-fieldset") as HTMLFieldSetElement;
  const legend = document.getElementById("spec-legend") as HTMLLegendElement;
  const hint = document.getElementById("spec-hint") as HTMLParagraphElement;
  const specFields = document.getElementById("spec-fields") as HTMLDivElement;
  const errorEl = document.getElementById("form-error") as HTMLParagraphElement;
  const successEl = document.getElementById("form-success") as HTMLParagraphElement;

  /** Rebuilds the spec inputs for the selected category. */
  function renderSpecFields(category: ComponentCategory | ""): void {
    specFields.replaceChildren();
    if (!category) {
      fieldset.hidden = true;
      return;
    }

    legend.textContent = `${category} specifications`;
    hint.textContent =
      category === "GPU"
        ? "No socket field — a GPU is a card on a bus, not a part seated in a socket."
        : category === "RAM"
          ? "A memory kit has neither a socket nor an architecture."
          : "Required fields are marked *; leave the rest blank if the part predates them.";

    for (const field of SPEC_FORM_FIELDS[category]) {
      const wrapper = document.createElement("div");
      wrapper.className = "form-row";

      const id = `spec-${field.key}`;
      const label = document.createElement("label");
      label.htmlFor = id;
      label.textContent = (field.unit ? `${field.label} (${field.unit})` : field.label) + (field.required ? " *" : "");
      wrapper.appendChild(label);

      if (field.kind === "select") {
        const select = document.createElement("select");
        select.id = id;
        select.dataset.specKey = field.key;
        const blank = document.createElement("option");
        blank.value = "";
        blank.textContent = field.required ? "Select…" : "—";
        select.appendChild(blank);
        for (const option of field.options ?? []) {
          const opt = document.createElement("option");
          opt.value = option;
          opt.textContent = option;
          select.appendChild(opt);
        }
        wrapper.appendChild(select);
      } else {
        const input = document.createElement("input");
        input.id = id;
        input.dataset.specKey = field.key;
        input.type = field.kind === "number" ? "number" : "text";
        if (field.kind === "number") {
          input.min = "0";
          input.step = "any";
        } else {
          input.maxLength = 40;
        }
        if (field.placeholder) input.placeholder = field.placeholder;
        wrapper.appendChild(input);
      }

      specFields.appendChild(wrapper);
    }

    fieldset.hidden = false;
  }

  categorySelect.addEventListener("change", () => renderSpecFields(categorySelect.value as ComponentCategory | ""));

  /** Collects the rendered spec inputs, omitting blanks. */
  function collectSpecs(): Record<string, SpecValue> {
    const specs: Record<string, SpecValue> = {};
    specFields.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-spec-key]").forEach((el) => {
      const key = el.dataset.specKey as string;
      const raw = el.value.trim();
      if (raw === "") return;
      specs[key] = el instanceof HTMLInputElement && el.type === "number" ? Number(raw) : raw;
    });
    return specs;
  }

  function showError(message: string): void {
    errorEl.hidden = false;
    errorEl.textContent = message;
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    errorEl.hidden = true;
    successEl.hidden = true;

    const data = new FormData(form);
    const category = String(data.get("category") || "") as ComponentCategory | "";
    const componentName = String(data.get("componentName") || "").trim();
    const manufacturer = String(data.get("manufacturer") || "").trim();
    const price = parseFloat(String(data.get("reportedPrice")));
    const year = parseInt(String(data.get("releaseYear")), 10);
    const proofUrl = String(data.get("proofUrl") || "").trim();

    if (!category) return showError("Select a category.");
    if (!componentName) return showError("Component name is required.");
    if (!manufacturer) return showError("Manufacturer is required.");
    if (!Number.isFinite(price) || price < 0) return showError("Observed price must be a valid non-negative number.");
    if (!Number.isFinite(year)) return showError("Release year is required.");
    if (!proofUrl) return showError("Proof of value URL is required.");
    try {
      new URL(proofUrl);
    } catch {
      return showError("Proof of value must be a valid URL.");
    }

    // Validated against the DATABASE contract rather than a form-local rule
    // set, so a submission is checked by exactly what the catalogue demands.
    const specs = collectSpecs();
    const issues = validateSpecs(specs, category);
    if (issues.length > 0) {
      return showError(issues.map((issue) => `${issue.field}: ${issue.message}`).join(" "));
    }

    const base = {
      // Attached automatically, but disclosed above rather than hidden: a
      // persistent identifier the contributor cannot see is a dark pattern.
      contributorHash: getOrCreateContributorHash(),
      sku: normalizeSku(componentName, category),
      componentName,
      manufacturer,
      releaseYear: year,
      reportedPrice: price,
      currency: String(data.get("currency")),
      proofUrl,
      contributorId: session ? session.username : getOrCreateAnonymousId(),
      contributorTier: (session ? "trusted" : "anonymous") as ContributorTier
    };

    // `validateSpecs` has just proved the bag matches the category's contract;
    // the switch is what carries that proof into the discriminated union.
    switch (category) {
      case "CPU":
        stageSubmission({ ...base, category, specs: specs as unknown as import("@modules/database/contracts").CpuSpecs });
        break;
      case "GPU":
        stageSubmission({ ...base, category, specs: specs as unknown as import("@modules/database/contracts").GpuSpecs });
        break;
      case "RAM":
        stageSubmission({ ...base, category, specs: specs as unknown as import("@modules/database/contracts").RamSpecs });
        break;
      case "MOBO":
        stageSubmission({ ...base, category, specs: specs as unknown as import("@modules/database/contracts").MoboSpecs });
        break;
      case "STORAGE":
        stageSubmission({ ...base, category, specs: specs as unknown as import("@modules/database/contracts").StorageSpecs });
        break;
    }

    form.reset();
    renderSpecFields("");
    successEl.hidden = false;
    successEl.textContent =
      "Submitted. Your entry is staged as Pending Validation and reaches the screener only after an admin approves it.";
  });
</script>
