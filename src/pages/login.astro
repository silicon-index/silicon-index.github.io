import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Sign In" activeNav="login">
  <div class="layout layout--form px-4">
    <main class="content content--narrow">
      <section class="form-panel" aria-labelledby="auth-heading">
        <div class="auth-tabs" role="tablist">
          <button type="button" class="auth-tab auth-tab--active" id="tab-login" role="tab" aria-selected="true">Sign In</button>
          <button type="button" class="auth-tab" id="tab-register" role="tab" aria-selected="false">Register</button>
        </div>

        <h1 id="auth-heading" class="visually-hidden">Sign In or Register</h1>

        <p class="form-note">
          Demo-only accounts, stored in this browser via <code>localStorage</code> — there is no server or real
          authentication yet (see <a href="/dev-index.md">Phase 5</a> of the roadmap). Try the seeded admin account:
          <code>admin</code> / <code>admin123</code>.
        </p>

        <form id="login-form">
          <div class="form-row">
            <label for="li-username">Username</label>
            <input type="text" id="li-username" required autocomplete="username" />
          </div>
          <div class="form-row">
            <label for="li-password">Password</label>
            <input type="password" id="li-password" required autocomplete="current-password" />
          </div>
          <p id="login-error" class="form-error" hidden></p>
          <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <form id="register-form" hidden>
          <div class="form-row">
            <label for="re-username">Username</label>
            <input type="text" id="re-username" required autocomplete="username" />
          </div>
          <div class="form-row">
            <label for="re-password">Password (min 6 characters)</label>
            <input type="password" id="re-password" required minlength="6" autocomplete="new-password" />
          </div>
          <p class="field-hint">New accounts are registered as contributors. Contributions can still be submitted anonymously without an account.</p>
          <p id="register-error" class="form-error" hidden></p>
          <p id="register-success" class="form-success" hidden></p>
          <button type="submit" class="btn-primary">Create Account</button>
        </form>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { login, register } from "@/lib/auth";

  const tabLogin = document.getElementById("tab-login") as HTMLButtonElement;
  const tabRegister = document.getElementById("tab-register") as HTMLButtonElement;
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const registerForm = document.getElementById("register-form") as HTMLFormElement;

  function switchTab(showLogin: boolean): void {
    loginForm.hidden = !showLogin;
    registerForm.hidden = showLogin;
    tabLogin.classList.toggle("auth-tab--active", showLogin);
    tabRegister.classList.toggle("auth-tab--active", !showLogin);
    tabLogin.setAttribute("aria-selected", String(showLogin));
    tabRegister.setAttribute("aria-selected", String(!showLogin));
  }

  tabLogin.addEventListener("click", () => switchTab(true));
  tabRegister.addEventListener("click", () => switchTab(false));

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById("login-error") as HTMLParagraphElement;
    errorEl.hidden = true;
    const username = (document.getElementById("li-username") as HTMLInputElement).value;
    const password = (document.getElementById("li-password") as HTMLInputElement).value;

    const result = await login(username, password);
    if (!result.ok || !result.session) {
      errorEl.hidden = false;
      errorEl.textContent = result.error || "Sign in failed.";
      return;
    }
    window.location.href = result.session.role === "admin" ? "/admin" : "/";
  });

  registerForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById("register-error") as HTMLParagraphElement;
    const successEl = document.getElementById("register-success") as HTMLParagraphElement;
    errorEl.hidden = true;
    successEl.hidden = true;
    const username = (document.getElementById("re-username") as HTMLInputElement).value;
    const password = (document.getElementById("re-password") as HTMLInputElement).value;

    const result = await register(username, password);
    if (!result.ok) {
      errorEl.hidden = false;
      errorEl.textContent = result.error || "Registration failed.";
      return;
    }
    successEl.hidden = false;
    successEl.textContent = "Account created. You can sign in now.";
    registerForm.reset();
    switchTab(true);
  });
</script>
