# Base URL of the deployed `database` module API (see deploy/database/).
# Optional: leave unset and the portal uses the market-database repo's raw
# `dev` branch, then the bundled mock dataset.
#
# PUBLIC_ vars are inlined into the client bundle — never put a secret here.
PUBLIC_API_URL=https://silicon-index-database-api.example.workers.dev

# Base URL of the admin API. The URL is public; the TOKEN is not — operators
# paste ADMIN_API_TOKEN into the dashboard at runtime. Never prefix it PUBLIC_.
PUBLIC_ADMIN_API_URL=https://silicon-index-admin-api.example.workers.dev

# HMAC secret for short-lived submission tokens (server-side only — NOT PUBLIC_).
# Must be at least 32 characters; the API fails closed without it.
#   openssl rand -base64 48
CONTRIBUTE_TOKEN_SECRET=

# Token lifetime in seconds (default 900 = 15 minutes).
CONTRIBUTE_TOKEN_TTL=900

# Database. A local file for containers; a libsql:// URL needs an auth token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ── Tier 2: per-module service tokens (Zero Trust) ────────────────────
# Long-lived shared secrets for privileged, module-to-module calls.
# Distinct per module on purpose: one token opens one module, never all.
# Minimum 24 characters. Routes that touch data FAIL CLOSED when unset.
#   openssl rand -base64 32
ADMIN_API_TOKEN=
DATABASE_API_TOKEN=

# Compute-only modules. Left unset, these endpoints stay public (they read and
# write nothing); set a value to require the token.
AI_API_TOKEN=
SCRAPERS_API_TOKEN=
CONTRIBUTORS_API_TOKEN=
